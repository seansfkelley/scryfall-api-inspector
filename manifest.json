{
  "manifest_version": 2,
  "name": "Scryfall API Inspector",
  "version": "1.0.1",
  "description": "Overlay an API link button on every Scryfall card image.",
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://scryfall.com/*",
        "*://*.scryfall.com/*",
        "*://scryfall.io/*",
        "*://*.scryfall.io/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
